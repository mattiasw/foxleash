{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["//#typecheck:bin"]
    },
    "test": {
      "dependsOn": ["//#test:bin"]
    },
    "//#typecheck:bin": {
      "inputs": ["bin/**", "packages/tsconfig/base.json"]
    },
    "//#test:bin": {
      "inputs": ["bin/**"]
    }
  }
}
