{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["//#typecheck:bin", "//#typecheck:e2e"]
    },
    "test": {
      "dependsOn": ["//#test:bin"],
      "env": ["FOXLEASH_TEST_REPORTER"]
    },
    "//#typecheck:bin": {
      "inputs": ["bin/**", "packages/tsconfig/base.json", "package-lock.json"]
    },
    "//#typecheck:e2e": {
      "inputs": [
        "e2e/**",
        "bin/**",
        "packages/tsconfig/base.json",
        "packages/protocol/package.json",
        "packages/protocol/src/**",
        "apps/server/package.json",
        "apps/server/src/**",
        "package-lock.json"
      ]
    },
    "//#test:bin": {
      "env": ["FOXLEASH_TEST_REPORTER"],
      "inputs": [
        "bin/**",
        ".github/workflows/dependabot-automerge.yml",
        "apps/server/src/**",
        "docs/amo/**"
      ]
    }
  }
}
