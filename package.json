{
  "name": "foxhand-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Let an AI agent use your own Firefox through MCP tools",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "biome check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "build:amo": "node bin/build-amo.ts",
    "check:release": "node bin/check-release.ts",
    "dev": "npm run dev -w @foxhand/extension",
    "setup": "node apps/server/src/main.ts install",
    "teardown": "node apps/server/src/main.ts uninstall",
    "doctor": "node apps/server/src/main.ts doctor",
    "probe": "node apps/server/src/main.ts probe",
    "check:test-integrity": "sh bin/check-test-integrity.sh",
    "test:bin": "node --test 'bin/**/*.test.ts'",
    "typecheck:bin": "tsc --noEmit -p bin",
    "e2e": "npm run build && node bin/install-firefox.ts && node --test --test-concurrency=1 --test-timeout=60000 'e2e/**/*.test.ts'",
    "typecheck:e2e": "tsc --noEmit -p e2e"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
