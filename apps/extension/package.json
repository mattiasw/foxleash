{
  "name": "@foxhand/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='lint.test.ts' 'src/**/*.test.ts' 'lint.test.ts'",
    "build": "node build.ts && node lint.ts",
    "dev": "node dev.ts"
  },
  "dependencies": {
    "@foxhand/protocol": "*"
  },
  "devDependencies": {
    "@foxhand/tsconfig": "*",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "web-ext": "^10.7.0"
  }
}
