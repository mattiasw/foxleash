{
  "manifest_version": 3,
  "name": "Foxleash",
  "description": "Lets an AI agent on your computer use this Firefox through MCP tools.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxleash@mattiasw.com",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "browsingActivity", "authenticationInfo"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'"
  },
  "options_ui": {
    "page": "options.html"
  },
  "action": {
    "default_title": "Foxleash",
    "default_icon": {
      "48": "icons/foxleash.svg",
      "96": "icons/foxleash.svg"
    },
    "default_area": "navbar"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "scripting",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "webNavigation",
    "storage",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "48": "icons/foxleash.svg",
    "96": "icons/foxleash.svg"
  }
}
