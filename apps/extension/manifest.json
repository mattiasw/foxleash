{
  "manifest_version": 3,
  "name": "Foxhand",
  "description": "Lets an AI agent on your computer use this Firefox through MCP tools.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxhand@mattiasw.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "browsingActivity", "authenticationInfo"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "scripting",
    "webRequest",
    "webNavigation",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "48": "icons/foxhand.svg",
    "96": "icons/foxhand.svg"
  }
}
