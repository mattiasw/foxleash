{
  "note": "Maps each capability and safeguard that docs/amo/listing.md states to the tools and code that provide it, and npm run check:release -- listing compares it with the listing, the manifest and the tools the server registers. An empty evidence list means the safeguard is not built yet, and it fails the release on purpose.",
  "capabilities": [
    {
      "listing": "open tabs and navigate them",
      "tools": [
        "tabs_list",
        "tab_open",
        "tab_close",
        "tab_select",
        "navigate",
        "wait_for",
        "resize_window"
      ]
    },
    { "listing": "read pages", "tools": ["read_page", "get_page_text"] },
    {
      "listing": "click, type and fill in forms",
      "tools": ["click", "type", "press_key", "hover", "scroll", "drag", "fill_form", "batch"]
    },
    { "listing": "take screenshots", "tools": ["screenshot"] },
    {
      "listing": "read the console and network activity",
      "tools": ["read_console", "read_network"]
    },
    { "listing": "upload files from allowed folders", "tools": ["upload_file"] },
    {
      "listing": "download files from sites you approved into your Firefox download folder",
      "tools": ["download"]
    }
  ],
  "safeguards": [
    {
      "listing": "The approval can only come from your click",
