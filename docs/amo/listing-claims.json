        { "file": "apps/extension/src/handlers.ts", "contains": "access.ask(" }
      ]
    },
    {
      "listing": "A built-in list of common financial and health sites is blocked by default",
      "evidence": [
        { "file": "apps/extension/src/default-blocklist.ts", "contains": "DEFAULT_BLOCKLIST" },
        { "file": "apps/extension/src/site-access.ts", "contains": "site_blocked" },
        { "file": "apps/extension/src/handlers.ts", "contains": "access.check(" }
      ]
    },
    {
      "listing": "File uploads only read from allowed folders",
      "evidence": [
